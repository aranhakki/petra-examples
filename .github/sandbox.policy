// GLOBAL CI SANDBOX
// Grants the minimum permissions required for the JDK Compiler to function in memory.
grant {
    // 1. Basic JVM Boot Properties
    permission java.util.PropertyPermission "*", "read";
    
    // 2. Allow compiler to read JDK standard libraries
    permission java.io.FilePermission "${java.home}/-", "read";
    
    // 3. Allow compiler to write intermediate dynamically generated classes
    permission java.io.FilePermission "${java.io.tmpdir}/-", "read,write,delete";
    permission java.io.FilePermission "/tmp/-", "read,write,delete";
    
    // 4. Allow compiler to scan the classpath for symbol resolution
    permission java.io.FilePermission "${maven.repo.local}/-", "read";
    permission java.io.FilePermission "${user.dir}/target/-", "read";
};
