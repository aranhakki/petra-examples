// 1. Whitelist Maven Surefire Booter (Required for JVM Forking & IPC)
grant codeBase "file:${maven.repo.local}/org/apache/maven/surefire/-" {
    permission java.security.AllPermission;
};

// 2. Whitelist JUnit (Required for test execution reflection)
grant codeBase "file:${maven.repo.local}/junit/-" {
    permission java.security.AllPermission;
};

// 3. Whitelist Petra Verifier (The Trusted IP Framework)
grant codeBase "file:${maven.repo.local}/com/cognitionbox/petra/-" {
    permission java.security.AllPermission;
};

// 4. THE STRICT SANDBOX (Applies to all untrusted PR code)
grant {
    // Core File & Property Access
    permission java.util.PropertyPermission "*", "read,write";
    permission java.io.FilePermission "${java.home}/-", "read";
    permission java.io.FilePermission "${maven.repo.local}/-", "read";
    permission java.io.FilePermission "${user.dir}/-", "read,write,delete";
    permission java.io.FilePermission "/tmp/-", "read,write,delete";
    
    // Reflection & Compilation (Required by petra-verifier, blocked from PRs by AST Gate)
    permission java.lang.RuntimePermission "accessDeclaredMembers";
    permission java.lang.RuntimePermission "getClassLoader";
    permission java.lang.reflect.ReflectPermission "suppressAccessChecks";
    permission java.lang.RuntimePermission "accessSystemModules";

    // Thread Management (Allows clean background shutdown, prevents ugly logs)
    permission java.lang.RuntimePermission "modifyThread";
};
