// 1. Whitelist the Maven Cache (The Framework) 
// (Includes triple-slash fallback for Linux URI normalization quirks)
grant codeBase "file:${maven.repo.local}/-" {
    permission java.security.AllPermission;
};
grant codeBase "file:///${maven.repo.local}/-" {
    permission java.security.AllPermission;
};

// 2. Whitelist Surefire's Booter (Trusted test runner)
grant codeBase "file:${user.dir}/target/surefire/-" {
    permission java.security.AllPermission;
};
grant codeBase "file:///${user.dir}/target/surefire/-" {
    permission java.security.AllPermission;
};

// 3. Dynamic Execution Engine (/tmp/)
grant codeBase "file:${java.io.tmpdir}/-" {
    permission java.security.AllPermission;
};
grant codeBase "file:/tmp/-" {
    permission java.security.AllPermission;
};

// 4. The PR Sandbox (Zero File Access, Zero Network Access)
// (This guarantees that even with a JavaParser zero-day, IP cannot be read)
grant {
    permission java.util.PropertyPermission "*", "read";
};
