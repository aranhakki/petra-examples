// 1. Whitelist the entire locked-down Maven cache (Safe because GOLDEN_POM prevents attackers from adding malicious JARs)
grant codeBase "file:${maven.repo.local}/-" {
    permission java.security.AllPermission;
};

// 2. The PR Sandbox (Zero Permissions Granted)
grant codeBase "file:${user.dir}/-" {
};
