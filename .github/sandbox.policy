// 1. Whitelist the Maven Cache (Trusted Dependencies)
grant codeBase "file:${maven.repo.local}/-" {
    permission java.security.AllPermission;
};

// 2. Whitelist the Tamper-Proof Framework Zone
grant codeBase "file:${user.dir}/target/classes/com/cognitionbox/petra/ast/-" {
    permission java.security.AllPermission;
};
grant codeBase "file:${user.dir}/target/test-classes/com/cognitionbox/petra/ast/-" {
    permission java.security.AllPermission;
};

// 3. Whitelist the Dynamic Execution Engine
grant codeBase "file:${java.io.tmpdir}/-" {
    permission java.security.AllPermission;
};
// Fallback for Linux hardcoded internal JDK compiler paths
grant codeBase "file:/tmp/-" {
    permission java.security.AllPermission;
};

// 4. The PR Sandbox (Zero File Access, Zero Network Access)
grant {
    permission java.util.PropertyPermission "*", "read";
};
