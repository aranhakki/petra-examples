grant {
    // 1. Core JVM & Property Access
    permission java.util.PropertyPermission "*", "read,write";
    permission java.io.FilePermission "${java.home}/-", "read";
    
    // 2. Local workspace and temp files (Needed by Surefire)
    permission java.io.FilePermission "${user.dir}/-", "read,write,delete";
    permission java.io.FilePermission "/tmp/-", "read,write,delete";
    
    // 3. Dependency reading for the Dynamic Compiler
    permission java.io.FilePermission "${maven.repo.local}/-", "read";
    
    // 4. Surefire Booter Runtime Requirements
    permission java.lang.RuntimePermission "setIO";
    permission java.lang.RuntimePermission "getClassLoader";
    permission java.lang.RuntimePermission "setContextClassLoader";
    permission java.lang.RuntimePermission "accessDeclaredMembers";
    permission java.lang.RuntimePermission "modifyThread";
    permission java.lang.RuntimePermission "modifyThreadGroup";
    permission java.lang.RuntimePermission "exitVM.*";
    
    // 5. Surefire 3.x TCP IPC (Strictly Localhost - NO OUTBOUND INTERNET)
    permission java.net.SocketPermission "localhost:1024-", "listen,resolve,connect,accept";
    permission java.net.SocketPermission "127.0.0.1:1024-", "listen,resolve,connect,accept";
};
